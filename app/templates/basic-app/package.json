{
  "name": "webaxp-basic-app",
  "version": "0.1.0",
  "private": true,
  "description": "A basic WebAXP application",
  "scripts": {
    "build": "rollup -c cicda/build/rollup.config.js",
    "test": "jest --config cicda/build/jest.config.js",
    "lint": "eslint app/src --ext .ts,.tsx --config cicda/build/.eslintrc.js",
    "dev": "rollup -c cicda/build/rollup.config.js -w",
    "start": "cd app && docker-compose up"
  },
  "dependencies": {
    "@net.webax/jcule": "^0.1.0",
    "@net.webax/jellicule": "^0.1.0",
    "@net.webax/webaxp-core": "^0.1.0",
    "@net.webax/webaxp-router": "^0.1.0",
    "@net.webax/webaxp-state": "^0.1.0",
    "@net.webax/webaxp-api": "^0.1.0",
    "@net.webax/webaxp-pwa": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "rollup": "^3.20.2",
    "rollup-plugin-typescript2": "^0.34.1",
    "rollup-plugin-terser": "^7.0.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  }
}
